{
  "compilerOptions": {
    //"noEmit": true,
    "module": "NodeNext",
    "declaration": true,
    "strict": true,
    //"allowJs": true,
    //"checkJs": true,
    "moduleResolution": "NodeNext",
    "isolatedModules": true,
    "sourceMap": true,
    "declarationMap": true,
    "allowSyntheticDefaultImports": true,
    //"esModuleInterop": true
    "types": ["node", "jest"],
    "rewriteRelativeImportExtensions": true,
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true
  }
}
