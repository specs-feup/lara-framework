<?xml version="1.0"?>
<!--
  Test language specification for 'this' type and generic types integration testing.
  
  Hierarchy:
    joinpoint (global)
      └── node (root)
            ├── expr
            │     └── binaryExpr
            └── stmt
                  └── loop
  
  This allows testing inheritance of 'this' types across multiple levels.
-->
<joinpoints root_alias="root" root_class="node">
    <!-- Base node - defines attributes/actions with 'this' type -->
    <joinpoint class="node"/>
    
    <!-- Expression hierarchy -->
    <joinpoint class="expr" extends="node"/>
    <joinpoint class="binaryExpr" extends="expr"/>
    
    <!-- Statement hierarchy -->
    <joinpoint class="stmt" extends="node"/>
    <joinpoint class="loop" extends="stmt"/>
    
    <!-- Standalone join point for testing typedef with generics -->
    <joinpoint class="container"/>
</joinpoints>
