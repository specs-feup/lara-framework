<?xml version="1.0"?>
<actions>
  <!-- Actions returning wildcard types -->
  <action name="getWildcardList" class="node" return="List&lt;?&gt;"/>
  <action name="getExtendsThis" class="node" return="Set&lt;? extends this&gt;"/>
  <action name="getSuperString" class="node" return="List&lt;? super String&gt;"/>
  
  <!-- Actions returning nested wildcards -->
  <action name="getNestedWildcard" class="node" return="Map&lt;?, List&lt;?&gt;&gt;"/>
  <action name="getDeeplyNested" class="node" return="List&lt;Map&lt;String, ? extends this&gt;&gt;"/>
  
  <!-- Actions returning wildcard arrays -->
  <action name="getWildcardArray" class="node" return="List&lt;?[]&gt;"/>
  <action name="getExtendsThisArray" class="node" return="Set&lt;? extends this[]&gt;"/>
  
  <!-- Actions returning multiple wildcards -->
  <action name="getMultiWildcard" class="node" return="Map&lt;?, ?&gt;"/>
  <action name="getMixedWildcard" class="node" return="Map&lt;? extends this, ? super String&gt;"/>
  
  <!-- Actions with wildcard parameters -->
  <action name="processWildcardList" class="node" return="void">
    <parameter name="items" type="List&lt;?&gt;"/>
  </action>
  
  <action name="processExtendsThis" class="node" return="void">
    <parameter name="items" type="Set&lt;? extends this&gt;"/>
  </action>
  
  <action name="processSuperString" class="node" return="void">
    <parameter name="items" type="List&lt;? super String&gt;"/>
  </action>
  
  <!-- Actions with nested wildcard parameters -->
  <action name="processNestedWildcard" class="node" return="void">
    <parameter name="map" type="Map&lt;?, List&lt;?&gt;&gt;"/>
  </action>
  
  <action name="processDeeplyNested" class="node" return="void">
    <parameter name="data" type="List&lt;Map&lt;String, ? extends this&gt;&gt;"/>
  </action>
  
  <!-- Actions with multiple wildcard parameters -->
  <action name="processMultipleWildcards" class="node" return="void">
    <parameter name="first" type="List&lt;?&gt;"/>
    <parameter name="second" type="Set&lt;? extends this&gt;"/>
    <parameter name="third" type="Map&lt;?, ? super String&gt;"/>
  </action>
  
  <!-- Actions with wildcard return AND parameters -->
  <action name="transformWildcard" class="node" return="List&lt;? extends this&gt;">
    <parameter name="input" type="Set&lt;?&gt;"/>
  </action>
  
  <action name="mergeWildcards" class="node" return="Map&lt;?, ?&gt;">
    <parameter name="left" type="Map&lt;? extends this, ?&gt;"/>
    <parameter name="right" type="Map&lt;?, ? super String&gt;"/>
  </action>
  
  <!-- Complex combinations with 'this' -->
  <action name="combineWithThis" class="node" return="Map&lt;this, ? extends this&gt;">
    <parameter name="source" type="List&lt;? extends this&gt;"/>
  </action>
  
  <!-- Actions on expr (to test inheritance with 'this') -->
  <action name="exprWildcard" class="expr" return="Set&lt;? extends this&gt;"/>
</actions>
