<?xml version="1.0"?>
<artifacts>
  <artifact class="node">
    <!-- Basic wildcard types -->
    <attribute name="wildcardList" type="List&lt;?&gt;"/>
    <attribute name="extendsThisList" type="List&lt;? extends this&gt;"/>
    <attribute name="mapStringWildcard" type="Map&lt;String, ?&gt;"/>
    <attribute name="superStringList" type="List&lt;? super String&gt;"/>
    
    <!-- Nested wildcards -->
    <attribute name="nestedWildcard" type="Map&lt;?, List&lt;?&gt;&gt;"/>
    <attribute name="deeplyNestedWildcard" type="List&lt;Map&lt;String, ? extends this&gt;&gt;"/>
    <attribute name="tripleNested" type="Map&lt;String, List&lt;Set&lt;?&gt;&gt;&gt;"/>
    
    <!-- Wildcard arrays -->
    <attribute name="wildcardArray" type="List&lt;?[]&gt;"/>
    <attribute name="extendsThisArray" type="List&lt;? extends this[]&gt;"/>
    <attribute name="superStringArray" type="Set&lt;? super String[]&gt;"/>
    
    <!-- Multiple wildcards -->
    <attribute name="multipleWildcards" type="Map&lt;?, ?&gt;"/>
    <attribute name="mixedWildcards" type="Map&lt;? extends this, ? super String&gt;"/>
    
    <!-- Combinations with 'this' -->
    <attribute name="setExtendsThis" type="Set&lt;? extends this&gt;"/>
    <attribute name="mapThisWildcard" type="Map&lt;this, ? super String&gt;"/>
    <attribute name="mapWildcardThis" type="Map&lt;? extends String, this&gt;"/>
    
    <!-- Complex combinations -->
    <attribute name="complexNested" type="Map&lt;? extends this, List&lt;? super String&gt;&gt;"/>
    <attribute name="wildcardOfThis" type="List&lt;? extends List&lt;this&gt;&gt;"/>
    
    <!-- Attributes with parameters -->
    <attribute name="filterByType" type="List&lt;? extends this&gt;">
      <parameter name="typeName" type="String"/>
    </attribute>
    <attribute name="findMatching" type="Set&lt;?&gt;">
      <parameter name="criteria" type="Map&lt;String, ?&gt;"/>
    </attribute>
    <attribute name="searchBetween" type="List&lt;? extends this&gt;">
      <parameter name="start" type="? extends this"/>
      <parameter name="end" type="? extends this"/>
    </attribute>
    <attribute name="transformWith" type="Map&lt;?, ? super String&gt;">
      <parameter name="transformer" type="List&lt;? extends this&gt;"/>
      <parameter name="options" type="Map&lt;String, ?&gt;"/>
    </attribute>
    <attribute name="collectInto" type="List&lt;?&gt;">
      <parameter name="target" type="List&lt;? super this&gt;"/>
    </attribute>
  </artifact>
  
  <artifact class="expr">
    <!-- Inherited wildcards should work with 'this' -->
    <attribute name="exprSpecific" type="Set&lt;? extends this&gt;"/>
  </artifact>
</artifacts>
