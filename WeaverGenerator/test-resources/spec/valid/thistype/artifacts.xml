<?xml version="1.0"?>
<!--
  Artifacts (attributes) for testing 'this' type and generic types.
  
  Test coverage:
  - 'this' as attribute return type
  - Array of 'this': this[]
  - Simple generics: List<String>, Map<String, Integer>
  - Generics with 'this': List<this>, Map<String, this>
  - Nested generics: List<List<this>>, Map<String, List<this>>
  - Typedef with generics and 'this'
  - Inheritance preservation of 'this' type
-->
<artifacts>
    
    <!-- Global attributes available to all join points -->
    <global>
        <!-- Simple 'this' return type on global -->
        <attribute name="root" type="this" tooltip="Returns the root of the AST with late-bound type"/>
        
        <!-- Array of 'this' type -->
        <attribute name="ancestors" type="this[]" tooltip="Returns all ancestors as array of late-bound type"/>
        
        <!-- Generic with 'this' on global -->
        <attribute name="siblings" type="List&lt;this&gt;" tooltip="Returns siblings as a list of late-bound type"/>
    </global>
    
    <!-- Base node attributes - inherited by all specific join points -->
    <artifact class="node" default="id">
        <!-- Simple 'this' as return type -->
        <attribute name="clone" type="this" tooltip="Creates a deep clone of this node"/>
        <attribute name="parent" type="this" tooltip="Returns the parent node with late-bound type"/>
        
        <!-- 'this' with parameters -->
        <attribute name="ancestorOfType" type="this" tooltip="Finds ancestor matching type name">
            <parameter name="typeName" type="String"/>
        </attribute>
        
        <!-- Attribute with 'this' as parameter type -->
        <attribute name="findSimilar" type="List&lt;this&gt;" tooltip="Finds nodes similar to target">
            <parameter name="target" type="this"/>
        </attribute>
        
        <!-- Attribute with multiple 'this' parameters -->
        <attribute name="findBetween" type="List&lt;this&gt;" tooltip="Finds nodes between two markers">
            <parameter name="start" type="this"/>
            <parameter name="end" type="this"/>
        </attribute>
        
        <!-- Array of 'this' -->
        <attribute name="children" type="this[]" tooltip="Returns direct children as array"/>
        <attribute name="descendants" type="this[]" tooltip="Returns all descendants as array"/>
        
        <!-- Multi-dimensional array of 'this' -->
        <attribute name="childrenMatrix" type="this[][]" tooltip="Returns children organized in 2D matrix"/>
        
        <!-- Simple generics (no 'this') -->
        <attribute name="attributes" type="Map&lt;String, String&gt;" tooltip="Returns attribute name-value pairs"/>
        <attribute name="tags" type="List&lt;String&gt;" tooltip="Returns list of tags"/>
        <attribute name="properties" type="Map&lt;String, Object&gt;" tooltip="Returns property map"/>
        
        <!-- Generic with 'this' as single type argument -->
        <attribute name="childList" type="List&lt;this&gt;" tooltip="Returns children as List"/>
        <attribute name="descendantSet" type="Set&lt;this&gt;" tooltip="Returns descendants as Set"/>
        
        <!-- Generic with 'this' as one of multiple type arguments -->
        <attribute name="namedChildren" type="Map&lt;String, this&gt;" tooltip="Returns children indexed by name"/>
        <attribute name="indexedNodes" type="Map&lt;Integer, this&gt;" tooltip="Returns nodes indexed by position"/>
        
        <!-- Nested generics with 'this' -->
        <attribute name="childGroups" type="List&lt;List&lt;this&gt;&gt;" tooltip="Returns children grouped in nested lists"/>
        <attribute name="categorizedNodes" type="Map&lt;String, List&lt;this&gt;&gt;" tooltip="Returns nodes categorized by type"/>
        
        <!-- Deeply nested generics -->
        <attribute name="hierarchy" type="Map&lt;String, Map&lt;String, this&gt;&gt;" tooltip="Returns nested categorization"/>
        
        <!-- Basic attributes for testing -->
        <attribute name="id" type="String"/>
        <attribute name="line" type="Integer"/>
        <attribute name="column" type="Integer"/>
    </artifact>
    
    <!-- Expression-specific attributes -->
    <artifact class="expr">
        <!-- Additional 'this'-typed attributes specific to expr -->
        <attribute name="simplify" type="this" tooltip="Returns simplified expression"/>
        
        <!-- Override-like pattern: same concept, different level -->
        <attribute name="normalize" type="this" tooltip="Returns normalized form"/>
        
        <!-- Generic returning 'this' specific to expressions -->
        <attribute name="subExpressions" type="List&lt;this&gt;" tooltip="Returns sub-expressions"/>
    </artifact>
    
    <!-- Binary expression specific -->
    <artifact class="binaryExpr">
        <attribute name="left" type="this" tooltip="Returns left operand with late-bound type"/>
        <attribute name="right" type="this" tooltip="Returns right operand with late-bound type"/>
        <attribute name="operands" type="List&lt;this&gt;" tooltip="Returns both operands as list"/>
    </artifact>
    
    <!-- Statement-specific attributes -->
    <artifact class="stmt">
        <attribute name="next" type="this" tooltip="Returns next statement"/>
        <attribute name="prev" type="this" tooltip="Returns previous statement"/>
        <attribute name="following" type="List&lt;this&gt;" tooltip="Returns all following statements"/>
    </artifact>
    
    <!-- Loop-specific attributes -->
    <artifact class="loop" default="kind">
        <attribute name="kind" type="String"/>
        <attribute name="body" type="this" tooltip="Returns loop body"/>
        <attribute name="nestedLoops" type="List&lt;this&gt;" tooltip="Returns nested loops"/>
        <attribute name="iterations" type="Integer"/>
    </artifact>
    
    <!-- Container for testing complex generics -->
    <artifact class="container">
        <!-- Complex nested generics -->
        <attribute name="deepNested" type="List&lt;Map&lt;String, List&lt;this&gt;&gt;&gt;" tooltip="Deeply nested generic with this"/>
        <attribute name="multiThis" type="Map&lt;this, this&gt;" tooltip="Map with this as both key and value"/>
    </artifact>
    
    <!-- Typedef definitions for testing generics in typedef fields -->
    <!-- Note: typedefs cannot use 'this' since they are not tied to a specific join point -->
    <typedef name="NodeInfo">
        <!-- Fields with various types and generics (but not 'this' which is only valid in artifacts) -->
        <attribute name="node" type="joinpoint"/>
        <attribute name="relatedNodes" type="List&lt;joinpoint&gt;"/>
        <attribute name="metadata" type="Map&lt;String, String&gt;"/>
        <attribute name="name" type="String"/>
    </typedef>
    
    <typedef name="TreeStructure">
        <!-- Testing nested generics in typedef -->
        <attribute name="root" type="joinpoint"/>
        <attribute name="levels" type="List&lt;List&lt;joinpoint&gt;&gt;"/>
        <attribute name="nodeIndex" type="Map&lt;String, joinpoint&gt;"/>
        <attribute name="depth" type="Integer"/>
    </typedef>
    
    <typedef name="SimpleMetadata">
        <!-- Regular typedef without 'this' for comparison -->
        <attribute name="name" type="String"/>
        <attribute name="values" type="List&lt;String&gt;"/>
        <attribute name="config" type="Map&lt;String, Object&gt;"/>
    </typedef>
    
    <!-- Object definition (type without fields initially) -->
    <object name="AstContext" tooltip="Contextual information for AST operations"/>
    
    <!-- Enum definitions -->
    <enum name="NodeKind" tooltip="Classification of node types">
        <value name="EXPRESSION"/>
        <value name="STATEMENT"/>
        <value name="DECLARATION"/>
        <value name="OTHER"/>
    </enum>
    
</artifacts>
